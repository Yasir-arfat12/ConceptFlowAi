{
  "name": "conceptflow-server",
  "version": "1.0.0",
  "description": "ConceptFlow AI – backend API server",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node seeds/seed.js",
    "db:reset": "node src/db/reset.js",
    "test": "node --test tests/contract.test.js",
    "test:contract": "node --test tests/contract.test.js",
    "test:ai": "node scripts/testAi.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@google/genai": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
